root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{js,jsx,ts,tsx,vue}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.blade.php]
indent_size = 4

[*.php]
indent_size = 4

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4